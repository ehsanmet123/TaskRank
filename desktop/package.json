{
  "name": "taskrank-desktop",
  "version": "1.0.10",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kianiharchegani.taskrank.desktop",
    "productName": "TaskRank",
    "directories": { "output": "dist" },
    "files": ["**/*", "!runtime-config.example.json"],
    "win": { "target": "nsis" },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    }
  }
}
